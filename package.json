{
  "name": "@ubiquity-os/ubiquity-os-kernel",
  "version": "7.3.0",
  "private": false,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:dev": "wrangler deploy --env development",
    "deploy:dry-run": "wrangler deploy --env=\"\" --dry-run --outdir .wrangler/tmp/dist",
    "test": "deno test --allow-all tests",
    "dev:gate": "wrangler dev --config gate/wrangler.jsonc",
    "deploy:gate": "wrangler deploy --config gate/wrangler.jsonc --env=\"\"",
    "deploy:gate:dev": "wrangler deploy --config gate/wrangler.jsonc --env development",
    "deploy:gate:dry-run": "wrangler deploy --config gate/wrangler.jsonc --env=\"\" --dry-run --outdir .wrangler/tmp/gate-dist"
  },
  "dependencies": {
    "@cfworker/json-schema": "2.0.1",
    "@octokit/auth-app": "8.0.2",
    "@octokit/core": "7.0.3",
    "@octokit/plugin-paginate-rest": "11.4.3",
    "@octokit/plugin-request-log": "5.3.1",
    "@octokit/plugin-rest-endpoint-methods": "13.3.1",
    "@octokit/plugin-retry": "7.1.4",
    "@octokit/plugin-throttling": "11.0.3",
    "@octokit/rest": "22.0.0",
    "@octokit/types": "14.1.0",
    "@octokit/webhooks": "14.2.0",
    "@octokit/webhooks-types": "7.6.1",
    "@sinclair/typebox": "0.34.41",
    "@ubiquity-os/plugin-sdk": "3.12.8",
    "graphology": "0.26.0",
    "hono": "4.9.1",
    "js-yaml": "4.1.0",
    "pino": "9.0.0",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
